From 3115caeb36148cc611de660d4fc19e1e59e4a69f Mon Sep 17 00:00:00 2001
From: acetone <63557806+freeacetone@users.noreply.github.com>
Date: Tue, 23 Jun 2026 10:41:43 +0300
Subject: [PATCH] libi2pd Log: add a callback sink (eLogCallback) for embedders

Adds a third log destination alongside file/stream/syslog: a std::function
sink invoked per message with the message's LogLevel and rendered text. This
lets an application embedding libi2pd route i2pd's logging into its own logging
system with the severity preserved (no second timestamp/level prefix to parse),
instead of scraping a pre-formatted ostream.

Non-invasive: a new eLogCallback enum value, a LogSink typedef, one member, and
one SendTo overload. Default behaviour (stdout/file/syslog) is unchanged; the
sink is active only after SendTo(LogSink) is called.
---
 libi2pd/Log.cpp | 12 ++++++++++++
 libi2pd/Log.h   | 12 ++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/libi2pd/Log.cpp b/libi2pd/Log.cpp
index eef5d196..f641dedf 100644
--- a/libi2pd/Log.cpp
+++ b/libi2pd/Log.cpp
@@ -13,6 +13,7 @@
 
 //for std::transform
 #include <algorithm>
+#include <utility>
 
 namespace i2p {
 namespace log {
@@ -180,6 +181,10 @@ namespace log {
 						<< "/" << g_LogLevelStr[msg->level]
 						<< " - " << msg->text << std::endl;
 				break;
+			case eLogCallback:
+				if (m_Sink)
+					m_Sink (msg->level, msg->text);
+				break;
 			case eLogStdout:
 			default:
 				std::cout << TimeAsString(msg->timestamp)
@@ -233,6 +238,13 @@ namespace log {
 		m_LogStream = os;
 	}
 
+	void Log::SendTo (LogSink sink) {
+		m_HasColors = false;
+		m_Destination = eLogCallback;
+		m_LogStream = nullptr;
+		m_Sink = std::move (sink);
+	}
+
 #ifndef _WIN32
 	void Log::SendTo(const char *name, int facility) {
 		if (m_MinLevel == eLogNone) return;
diff --git a/libi2pd/Log.h b/libi2pd/Log.h
index 18592c9e..aab213ad 100644
--- a/libi2pd/Log.h
+++ b/libi2pd/Log.h
@@ -39,6 +39,7 @@ enum LogType {
 	eLogStdout = 0,
 	eLogStream,
 	eLogFile,
+	eLogCallback,
 #ifndef _WIN32
 	eLogSyslog,
 #endif
@@ -49,6 +50,10 @@ namespace log {
 
 	struct LogMsg; /* forward declaration */
 
+	/* Sink receiving each message's level and rendered text; lets an embedder
+	   route i2pd logging into its own logging system, preserving the level. */
+	typedef std::function<void (LogLevel level, const std::string& text)> LogSink;
+
 	class Log
 	{
 		private:
@@ -56,6 +61,7 @@ namespace log {
 			enum LogType m_Destination;
 			enum LogLevel m_MinLevel;
 			std::shared_ptr<std::ostream> m_LogStream;
+			LogSink m_Sink;
 			std::string m_Logfile;
 			std::time_t m_LastTimestamp;
 			char m_LastDateTime[64];
@@ -111,6 +117,12 @@ namespace log {
 			 */
 			void SendTo (std::shared_ptr<std::ostream> os);
 
+			/**
+			 * @brief Sets log destination to a callback sink
+			 * @param sink Function invoked per message with its level and text
+			 */
+			void SendTo (LogSink sink);
+
 			/**
 			 * @brief Sets format for timestamps in log
 			 * @param format String with timestamp format
