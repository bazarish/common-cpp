#!/bin/sh
# Bazarish project (c) 2026
# Enable once per clone:  git config core.hooksPath common/tools/git-hooks
set -e
for audit in common/tools/audit-error-hiding.py common/tools/audit-ownership.py; do
    if [ ! -f "$audit" ]; then
        echo "pre-commit: $audit missing (is the common submodule checked out?)" >&2
        exit 1
    fi
    python3 "$audit" $(git rev-parse --show-toplevel >/dev/null && echo .)
done
